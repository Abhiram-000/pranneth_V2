<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_2">

    <!-- Left-aligned, per layout variance: no centered hero -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Personal safety"
        android:textAppearance="@style/TextAppearance.RS.Eyebrow" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="Help without reaching for your phone"
        android:textAppearance="@style/TextAppearance.RS.H1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:text="A deliberate shake — or Volume Up and Down together — opens a countdown from the lock screen. Nothing is sent until that countdown ends, so a bump on a bus never alerts anyone."
        android:textAppearance="@style/TextAppearance.RS.Body" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- The one memorable object: the SOS target, previewed -->
    <TextView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="start"
        android:background="@drawable/bg_sos_target"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:text="SOS"
        android:textColor="@color/text_on_danger"
        android:textSize="30sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="Setup takes about two minutes."
        android:textAppearance="@style/TextAppearance.RS.Data" />
</LinearLayout>

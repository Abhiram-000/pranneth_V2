<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📱"
        android:textSize="64sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Permissions Needed"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RakshaSetu needs these permissions to protect you:\n\n• SMS — Send emergency alerts to contacts\n• Phone — Make emergency calls to 112\n• Location — Share your location during emergencies\n• Notifications — Show SOS quick action"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="24dp"
        android:gravity="center" />

</LinearLayout>

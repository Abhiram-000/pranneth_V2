<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/gutter"
    android:paddingTop="@dimen/space_10"
    android:paddingBottom="@dimen/space_8">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calibration"
        android:textAppearance="@style/TextAppearance.RS.Eyebrow" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="Teach the app your shake"
        android:textAppearance="@style/TextAppearance.RS.H1" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="Six deliberate shakes, as hard as you would in a real emergency."
        android:textAppearance="@style/TextAppearance.RS.Body" />

    <!-- Progress ring -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:layout_weight="1">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            app:indicatorColor="@color/accent"
            app:indicatorSize="220dp"
            app:trackColor="@color/hairline_default"
            app:trackThickness="3dp" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-black"
            android:text="0/6"
            android:textColor="@color/text_primary"
            android:textSize="40sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCalibrationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.RS.Data" />

    <!-- Instructions -->
    <LinearLayout
        android:id="@+id/layoutInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:background="@drawable/bg_surface"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to do it"
            android:textAppearance="@style/TextAppearance.RS.Eyebrow" />

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="Hold the phone the way you normally would — in a pocket or a hand — and shake three times, pause, then three more. Sharp, uneven shakes work; steady rhythm does not."
            android:textAppearance="@style/TextAppearance.RS.Body" />
    </LinearLayout>

    <!-- Results -->
    <LinearLayout
        android:id="@+id/layoutResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:background="@drawable/bg_surface"
        android:orientation="vertical"
        android:padding="@dimen/space_4"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calibrated"
            android:textAppearance="@style/TextAppearance.RS.Eyebrow"
            android:textColor="@color/success_green" />

        <TextView
            android:id="@+id/tvResultThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.RS.Data" />

        <TextView
            android:id="@+id/tvResultSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.RS.Data" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartCalibration"
        style="@style/Widget.RS.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:text="Start calibration" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSkip"
        style="@style/Widget.RS.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="Skip for now" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_dark"
    android:gravity="center"
    android:padding="32dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/glass_card_solid"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1dp"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery Optimization"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <View
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:background="@color/md_theme_primary"
                android:layout_marginTop="16dp"
                android:alpha="0.5" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="On many Android devices, battery optimization can kill safety apps in the background."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="24dp"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="We'll guide you through disabling it for RakshaSetu so it works reliably when you need it."
                android:textSize="14sp"
                android:textColor="@color/text_glass"
                android:layout_marginTop="12dp"
                android:gravity="center" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

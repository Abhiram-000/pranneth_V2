<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark">

    <!-- Glow orb for depth -->
    <View
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_sos_glow"
        android:alpha="0.2" />

    <!-- Visible countdown layout -->
    <LinearLayout
        android:id="@+id/layoutCountdownVisual"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <!-- Warning icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOS"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/status_inactive"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-black" />

        <!-- Trigger source -->
        <TextView
            android:id="@+id/tvTriggerSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Triggered by: Unknown"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <!-- Countdown timer - Glass card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="180dp"
            android:layout_height="180dp"
            app:cardCornerRadius="90dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/glass_sos"
            app:strokeColor="@color/sos_glass_border"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvCountdownNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="10"
                    android:textSize="72sp"
                    android:textStyle="bold"
                    android:textColor="@color/countdown_text"
                    android:fontFamily="sans-serif-black" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY ALERT"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/countdown_text"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alert will be sent to your emergency contacts\nand 112 with your live GPS location"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <!-- Location status -->
        <TextView
            android:id="@+id/tvLocationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acquiring GPS fix..."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp" />

        <!-- I'm Safe Button - Glass -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSafe"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="I'M SAFE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/safe_button"
            android:layout_marginTop="40dp"
            app:cornerRadius="20dp"
            app:strokeColor="#3334D399"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to cancel  •  Long press for duress cancel"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- Silent countdown layout -->
    <LinearLayout
        android:id="@+id/layoutSilentVisual"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Silent Alert Active"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSilentCountdownHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alert will be sent silently..."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Countdown timer - Glass card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:cardCornerRadius="70dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/glass_card_solid"
            app:strokeColor="@color/glass_border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvSilentCountdownNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="30"
                    android:textSize="56sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-black" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvSilentCountdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="seconds until silent alert"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <!-- Location status -->
        <TextView
            android:id="@+id/tvSilentLocationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acquiring GPS fix..."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp" />

        <!-- Cancel button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSilentCancel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CANCEL"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/glass_card_solid"
            android:layout_marginTop="40dp"
            app:cornerRadius="16dp"
            app:strokeColor="@color/glass_border"
            app:strokeWidth="1dp" />
    </LinearLayout>

</FrameLayout>

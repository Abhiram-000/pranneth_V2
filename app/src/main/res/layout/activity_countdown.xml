<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/countdown_background">

    <!-- Main countdown container -->
    <LinearLayout
        android:id="@+id/countdownContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Warning icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨"
            android:textSize="72sp"
            android:layout_marginBottom="16dp" />

        <!-- Countdown timer -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10"
            android:textSize="96sp"
            android:textStyle="bold"
            android:textColor="@color/countdown_text"
            android:fontFamily="sans-serif-black" />

        <!-- Status text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY ALERT"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/countdown_text"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alert will be sent to your emergency contacts"
            android:textSize="14sp"
            android:textColor="@color/countdown_text_secondary"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <!-- I'm Safe Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSafe"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="✋ I'M SAFE"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/safe_button"
            android:layout_marginTop="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to cancel • Long press for duress cancel"
            android:textSize="12sp"
            android:textColor="@color/countdown_text_secondary"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        RAKSHASETU DESIGN TOKENS
        Aesthetic: "instrument-grade safety" — near-black ink base, one ember accent
        reserved for danger/action, jade for safety, hairline separation instead of
        stacked glass panels. Glow is functional attention only (the SOS target).

        Token groups: base surfaces · hairlines · text · brand/danger/safe · data
    -->

    <!-- ===== BASE SURFACES ===== -->
    <color name="surface_base">#0B0F14</color>
    <color name="surface_sunken">#070A0E</color>
    <color name="surface_raised">#121821</color>
    <color name="surface_overlay">#18202B</color>
    <color name="scrim">#B305070A</color>

    <!-- ===== HAIRLINES (replaces stacked glass borders) ===== -->
    <color name="hairline_subtle">#1FFFFFFF</color>
    <color name="hairline_default">#26FFFFFF</color>
    <color name="hairline_strong">#3DFFFFFF</color>

    <!-- ===== TEXT ===== -->
    <color name="text_primary">#F2F5F8</color>
    <color name="text_secondary">#A3B0BF</color>
    <color name="text_muted">#6B7889</color>
    <color name="text_on_accent">#1A0B07</color>
    <color name="text_on_danger">#FFF6F4</color>
    <color name="text_on_safe">#04210F</color>

    <!-- ===== BRAND / ACTION ===== -->
    <color name="accent">#FF6A3D</color>
